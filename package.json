{
  "name": "ai-frontier-town", "private": true, "type": "module", "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently -k 'pnpm dev:server' 'pnpm dev:web'",
    "dev:server": "node --env-file=.env --import tsx --watch apps/server/src/main.ts", "dev:web": "vite --config apps/web/vite.config.ts",
    "worker": "node --env-file-if-exists=.env --import tsx apps/server/src/worker.ts", "migrate": "node --env-file-if-exists=.env --import tsx packages/db/src/migrate.ts",
    "build": "vite build --config apps/web/vite.config.ts", "typecheck": "vue-tsc --noEmit",
    "test": "vitest run", "test:m0": "vitest run tests/m0.test.ts", "test:browser": "playwright test",
    "start": "node --env-file-if-exists=.env --import tsx apps/server/src/main.ts"
  },
  "dependencies": {"@fastify/cookie":"^11.0.2","@fastify/static":"^8.2.0","@fastify/websocket":"^11.2.0","drizzle-orm":"^0.44.5","fastify":"^5.6.1","pg":"^8.16.3","phaser":"^3.90.0","vue":"^3.5.22","zod":"^3.25.76"},
  "devDependencies": {"@playwright/test":"^1.56.0","@types/node":"^22.18.0","@types/pg":"^8.15.5","@types/ws":"^8.18.1","@vitejs/plugin-vue":"^5.2.4","concurrently":"^9.2.1","tsx":"^4.20.5","typescript":"^5.9.3","vite":"^6.3.6","vitest":"^3.2.4","vue-tsc":"^3.1.1","ws":"^8.18.3"}
}
